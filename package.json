{
  "name": "memoflow",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w memoflow-server\" \"npm run dev -w memoflow-client\"",
    "start": "npm run start -w memoflow-server",
    "build": "npm run build -w memoflow-client",
    "test": "npm run test -w memoflow-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
